+#[cfg(test)]
+mod report_localization_tests {
+    #[test]
+    fn localized_report_preserves_data_and_leaves_export_format_unchanged() {
+        let mut engine = soundcraft_engine::demo::demo_engine();
+        let name = "Original {name} 東京\tMute.wav";
+        let path = "/synthetic/한글 {users}.wav";
+        engine.session_mut().sources[0].name = name.into();
+        engine.session_mut().sources[0].path = path.into();
+        let before = serde_json::to_value(engine.session()).unwrap();
+        let exported = soundcraft_engine::inspect::session_text(&engine);
+        for language in crate::i18n::Language::ALL {
+            crate::i18n::activate(language);
+            let report = super::localized_session_report(&engine);
+            assert!(report.contains(name));
+            assert!(report.contains(path));
+            if language != crate::i18n::Language::En {
+                assert!(!report.contains("Files in session"));
+                assert!(!report.contains("Track listing"));
+                assert!(!report.contains("Int24"));
+            }
+            assert_eq!(serde_json::to_value(engine.session()).unwrap(), before);
+            assert_eq!(soundcraft_engine::inspect::session_text(&engine), exported);
+        }
+        crate::i18n::activate(crate::i18n::Language::En);
+    }
+}
