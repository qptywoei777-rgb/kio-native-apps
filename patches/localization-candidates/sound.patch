+//! KIO Sound's presentation-only catalogs. Session text and command wire values are unchanged.
+//! No network access or translation service is used at runtime.
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Language {
+    Vi,
+    En,
+    Ko,
+    Ja,
+    ZhTw,
+    ZhCn,
+}
+impl Language {
+    pub const ALL: [Self; 6] = [Self::Vi, Self::En, Self::Ko, Self::Ja, Self::ZhTw, Self::ZhCn];
+    pub const fn code(self) -> &'static str {
+        match self {
+            Self::Vi => "vi",
+            Self::En => "en",
+            Self::Ko => "ko",
+            Self::Ja => "ja",
+            Self::ZhTw => "zh-TW",
+            Self::ZhCn => "zh-CN",
+        }
+    }
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Vi => "Tiếng Việt",
+            Self::En => "English",
+            Self::Ko => "한국어",
+            Self::Ja => "日本語",
+            Self::ZhTw => "繁體中文",
+            Self::ZhCn => "简体中文",
+        }
+    }
+    fn index(self) -> usize {
+        match self {
+            Self::Vi => 0,
+            Self::En => 1,
+            Self::Ko => 2,
+            Self::Ja => 3,
+            Self::ZhTw => 4,
+            Self::ZhCn => 5,
+        }
+    }
+}
+thread_local! { static CURRENT: Cell<Language> = const { Cell::new(Language::En) }; }
+pub fn current() -> Language {
+    CURRENT.with(Cell::get)
+}
+pub fn activate(language: Language) {
+    CURRENT.with(|value| value.set(language));
+}
+
+/// Script takes priority over region: zh-Hant-CN remains Traditional Chinese.
+pub fn normalize(tag: &str) -> Option<Language> {
+    let tag = tag.trim().replace('_', "-").to_ascii_lowercase();
+    let tag = tag.split(['.', '@']).next().unwrap_or("");
+    let parts: Vec<_> = tag.split('-').collect();
+    match parts.first().copied()? {
+        "vi" => Some(Language::Vi),
+        "en" => Some(Language::En),
+        "ko" => Some(Language::Ko),
+        "ja" => Some(Language::Ja),
+        "zh" if parts.contains(&"hant") => Some(Language::ZhTw),
+        "zh" if parts.contains(&"hans") => Some(Language::ZhCn),
+        "zh" if parts.iter().any(|part| matches!(*part, "tw" | "hk" | "mo")) => Some(Language::ZhTw),
+        "zh" => Some(Language::ZhCn),
+        _ => None,
+    }
+}
+pub fn resolve(saved: Option<&str>, operating_system: &[String]) -> Language {
+    saved.and_then(normalize).or_else(|| operating_system.iter().find(|s| !s.trim().is_empty()).and_then(|s| normalize(s))).unwrap_or(Language::En)
+}
+/// The native desktop probes the real OS UI preference before constructing its first frame.
+pub fn startup(saved: Option<&str>) -> Language {
+    if let Some(language) = saved.and_then(normalize) {
+        activate(language);
+        return language;
+    }
+    static OS: OnceLock<Vec<String>> = OnceLock::new();
+    let language = resolve(None, OS.get_or_init(os_languages));
+    activate(language);
+    language
+}
+fn os_languages() -> Vec<String> {
+    #[cfg(target_os = "macos")]
+    if let Some(output) = native_output("/usr/bin/defaults", &["read", "-g", "AppleLanguages"]) {
+        let values: Vec<String> = output.split([',', '\n', '(', ')', '"']).map(str::trim).filter(|s| !s.is_empty()).map(str::to_owned).collect();
+        if !values.is_empty() {
+            return values;
+        }
+    }
+    #[cfg(target_os = "windows")]
+    if let Some(output) = native_output(
+        "powershell.exe",
+        &[
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;[System.Globalization.CultureInfo]::CurrentUICulture.Name",
+        ],
+    ) {
+        let value = output.trim().to_owned();
+        if !value.is_empty() {
+            return vec![value];
+        }
+    }
+    ["LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"]
+        .iter()
+        .filter_map(|key| std::env::var(key).ok())
+        .flat_map(|s| s.split(':').map(str::to_owned).collect::<Vec<_>>())
+        .collect()
+}
+
+// A broken OS helper must not block the audio application's startup indefinitely.
+#[cfg(any(target_os = "macos", target_os = "windows"))]
+fn native_output(program: &str, args: &[&str]) -> Option<String> {
+    use std::process::{Command, Stdio};
+    let mut command = Command::new(program);
+    command.args(args).stdout(Stdio::piped()).stderr(Stdio::null());
+    #[cfg(target_os = "windows")]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x0800_0000);
+    }
+    let mut child = command.spawn().ok()?;
+    let start = std::time::Instant::now();
+    loop {
+        if child.try_wait().ok()?.is_some() {
+            let output = child.wait_with_output().ok()?;
+            return output.status.success().then(|| String::from_utf8_lossy(&output.stdout).trim_start_matches('\u{feff}').to_string());
+        }
+        if start.elapsed() >= std::time::Duration::from_secs(2) {
+            let _ = child.kill();
+            let _ = child.wait();
+            return None;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
+
+const SOURCES: [&str; 6] = [
+    include_str!("vi.tsv"),
+    include_str!("en.tsv"),
+    include_str!("ko.tsv"),
+    include_str!("ja.tsv"),
+    include_str!("zh-TW.tsv"),
+    include_str!("zh-CN.tsv"),
+];
+struct Catalog {
+    exact: HashMap<String, String>,
+    templates: Vec<(String, String)>,
+}
+fn unescape(value: &str) -> String {
+    let mut result = String::new();
+    let mut chars = value.chars();
+    while let Some(c) = chars.next() {
+        if c == '\\' {
+            match chars.next() {
+                Some('n') => result.push('\n'),
+                Some('t') => result.push('\t'),
+                Some(c) => result.push(c),
+                None => result.push('\\'),
+            }
+        } else {
+            result.push(c);
+        }
+    }
+    result
+}
+fn catalogs() -> &'static [Catalog; 6] {
+    static CATALOGS: OnceLock<[Catalog; 6]> = OnceLock::new();
+    CATALOGS.get_or_init(|| {
+        SOURCES.map(|source| {
+            let mut exact = HashMap::new();
+            let mut templates = Vec::new();
+            for row in source.lines().filter(|line| !line.is_empty() && !line.starts_with('#')) {
+                let mut columns = row.splitn(3, '\t');
+                if let (Some(_context), Some(key), Some(value)) = (columns.next(), columns.next(), columns.next()) {
+                    let key = unescape(key);
+                    let value = unescape(value);
+                    if key.contains('{') {
+                        templates.push((key.clone(), value.clone()));
+                    }
+                    exact.insert(key, value);
+                }
+            }
+            // Specific prose before broad templates such as "{} tracks".
+            templates.sort_by_key(|(key, _)| std::cmp::Reverse(key.len()));
+            Catalog { exact, templates }
+        })
+    })
+}
+/// Only call at a presentation boundary. Unknown external errors and user-authored text pass through.
+pub fn t(text: &str) -> String {
+    translate(current(), text)
+}
+pub fn translate(language: Language, text: &str) -> String {
+    if language == Language::En {
+        return text.to_owned();
+    }
+    let catalog = &catalogs()[language.index()];
+    if let Some(value) = catalog.exact.get(text) {
+        return value.clone();
+    }
+    for (source, translated) in &catalog.templates {
+        if let Some(value) = render_template(source, translated, text) {
+            return value;
+        }
+    }
+    // Preserve common accelerators/ellipsis adornments without duplicating every catalog row.
+    for ending in ["...", "…", ":"] {
+        if let Some(base) = text.strip_suffix(ending)
+            && let Some(value) = catalog.exact.get(base)
+        {
+            return format!("{value}{ending}");
+        }
+    }
+    text.to_owned()
+}
+#[derive(Debug)]
+enum Part<'a> {
+    Text(&'a str),
+    Slot(&'a str),
+}
+fn parts(pattern: &str) -> Option<Vec<Part<'_>>> {
+    let mut out = Vec::new();
+    let mut start = 0;
+    while let Some(offset) = pattern.get(start..)?.find('{') {
+        let a = start + offset;
+        let b = a + pattern.get(a..)?.find('}')?;
+        if pattern.get(a..)?.starts_with("{{") {
+            return None;
+        }
+        out.push(Part::Text(pattern.get(start..a)?));
+        out.push(Part::Slot(pattern.get(a + 1..b)?));
+        start = b + 1;
+    }
+    out.push(Part::Text(pattern.get(start..)?));
+    Some(out)
+}
+/// Match formatted text against its source template, retaining every formatted argument verbatim.
+/// Numeric Rust format specifications are part of slot identity; translations may reorder slots.
+fn render_template(source: &str, translated: &str, rendered: &str) -> Option<String> {
+    let source = parts(source)?;
+    if source.len() < 3 {
+        return None;
+    }
+    let mut remaining = rendered;
+    let mut values: HashMap<String, &str> = HashMap::new();
+    let mut ordinal = 0;
+    for (i, part) in source.iter().enumerate() {
+        match part {
+            Part::Text(text) => remaining = remaining.strip_prefix(text)?,
+            Part::Slot(slot) => {
+                let delimiter = source.iter().skip(i + 1).find_map(|p| match p {
+                    Part::Text(text) if !text.is_empty() => Some(*text),
+                    _ => None,
+                });
+                let end = match delimiter {
+                    Some(text) => remaining.find(text)?,
+                    None => remaining.len(),
+                };
+                let value = remaining.get(..end)?;
+                remaining = remaining.get(end..)?;
+                let key = if slot.is_empty() || slot.starts_with(':') {
+                    let key = format!("@{ordinal}{slot}");
+                    ordinal += 1;
+                    key
+                } else {
+                    (*slot).to_owned()
+                };
+                values.insert(key, value);
+            }
+        }
+    }
+    if !remaining.is_empty() {
+        return None;
+    }
+    let mut result = String::new();
+    let mut ordinal = 0;
+    for part in parts(translated)? {
+        match part {
+            Part::Text(text) => result.push_str(text),
+            Part::Slot(slot) => {
+                let key = if slot.is_empty() || slot.starts_with(':') {
+                    let key = format!("@{ordinal}{slot}");
+                    ordinal += 1;
+                    key
+                } else {
+                    slot.to_owned()
+                };
+                result.push_str(values.get(&key)?);
+            }
+        }
+    }
+    Some(result)
+}
+/// Selected language first, followed by the stable suite order with no duplicate entry.
+pub fn menu_order(language: Language) -> Vec<Language> {
+    std::iter::once(language).chain(Language::ALL.into_iter().filter(|l| *l != language)).collect()
+}
+pub fn language_menu(app: &mut crate::SoundApp, ui: &mut egui::Ui) {
+    let selected = current();
+    ui.menu_button(format!("🌐 {}", selected.name()), |ui| {
+        ui.set_min_width(180.0);
+        for language in menu_order(selected) {
+            if ui.selectable_label(language == selected, format!("{} {}", if language == selected { "✓" } else { "  " }, language.name())).clicked()
+            {
+                app.set_language(language);
+                ui.ctx().request_repaint();
+                ui.close();
+            }
+        }
+    })
+    .response
+    .on_hover_text(t("Language"));
+}
