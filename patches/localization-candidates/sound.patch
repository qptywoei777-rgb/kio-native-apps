+/// Present the same report fields from structured data. Do not translate or
+/// parse the CLI/export report: filenames and comments may contain any text.
+fn localized_session_report(engine: &soundcraft_engine::Engine) -> String {
+    use std::fmt::Write;
+    fn field(out: &mut String, key: &str, value: impl std::fmt::Display) {
+        let _ = writeln!(out, "{}:\t{value}", crate::i18n::t(key));
+    }
+    fn columns(out: &mut String, keys: &[&str]) {
+        let _ = writeln!(out, "{}", keys.iter().map(|key| crate::i18n::t(key)).collect::<Vec<_>>().join("\t"));
+    }
+    let s = engine.session();
+    let position = |sample| s.format_position(sample, soundcraft_time::TimeFormat::MinSecs);
+    let mut out = String::new();
+    field(&mut out, "Session name", &s.name);
+    field(&mut out, "Sample rate", s.sample_rate.hz());
+    field(&mut out, "Bit depth", crate::i18n::bit_depth_label(&format!("{:?}", s.bit_depth)));
+    field(&mut out, "Timecode format", crate::i18n::t(s.frame_rate.label()));
+    field(&mut out, "Audio tracks", s.tracks.iter().filter(|t| t.kind == soundcraft_model::TrackKind::Audio).count());
+    field(&mut out, "Clips", s.tracks.iter().map(|t| t.clips().len()).sum::<usize>());
+    field(&mut out, "Audio files", s.sources.len());
+    let _ = writeln!(out, "\n{}", crate::i18n::t("Files in session"));
+    columns(&mut out, &["Filename", "Location"]);
+    for source in &s.sources {
+        let _ = writeln!(out, "{}\t{}", source.name, source.path);
+    }
+    let _ = writeln!(out, "\n{}", crate::i18n::t("Track listing"));
+    for track in &s.tracks {
+        field(&mut out, "Track name", &track.name);
+        field(&mut out, "Comments", &track.comments);
+        let state: Vec<_> = [(track.inactive, "Inactive"), (track.mixer.mute, "Muted"), (track.mixer.solo, "Solo")]
+            .into_iter()
+            .filter_map(|(on, key)| on.then(|| crate::i18n::t(key)))
+            .collect();
+        field(&mut out, "State", state.join(" "));
+        columns(&mut out, &["Channel", "Event", "Clip name", "Start time", "End time", "Duration", "State"]);
+        for (index, clip) in track.clips().iter().enumerate() {
+            let _ = writeln!(
+                out,
+                "1\t{}\t{}\t{}\t{}\t{}\t{}",
+                index + 1,
+                clip.name,
+                position(clip.start),
+                position(clip.end()),
+                position(clip.length),
+                crate::i18n::t(if clip.muted { "Muted" } else { "Unmuted" })
+            );
+        }
+        out.push('\n');
+    }
+    let _ = writeln!(out, "{}", crate::i18n::t("Markers listing"));
+    columns(&mut out, &["#", "Location", "Name"]);
+    for marker in &s.markers {
+        let _ = writeln!(out, "{}\t{}\t{}", marker.number, position(marker.start), marker.name);
+    }
+    out
 }
 
