+const SOURCES: [&str; 6] = [
+    include_str!("vi.tsv"),
+    include_str!("en.tsv"),
+    include_str!("ko.tsv"),
+    include_str!("ja.tsv"),
+    include_str!("zh-TW.tsv"),
+    include_str!("zh-CN.tsv"),
+];
+struct Catalog {
+    exact: HashMap<String, String>,
+    templates: Vec<(String, String)>,
+}
+fn unescape(value: &str) -> String {
+    let mut result = String::new();
+    let mut chars = value.chars();
+    while let Some(c) = chars.next() {
+        if c == '\\' {
+            match chars.next() {
+                Some('n') => result.push('\n'),
+                Some('t') => result.push('\t'),
+                Some(c) => result.push(c),
+                None => result.push('\\'),
+            }
+        } else {
+            result.push(c);
+        }
+    }
+    result
+}
+fn catalogs() -> &'static [Catalog; 6] {
+    static CATALOGS: OnceLock<[Catalog; 6]> = OnceLock::new();
+    CATALOGS.get_or_init(|| {
+        SOURCES.map(|source| {
+            let mut exact = HashMap::new();
+            let mut templates = Vec::new();
+            for row in source.lines().filter(|line| !line.is_empty() && !line.starts_with('#')) {
+                let mut columns = row.splitn(3, '\t');
+                if let (Some(_context), Some(key), Some(value)) = (columns.next(), columns.next(), columns.next()) {
+                    let key = unescape(key);
+                    let value = unescape(value);
+                    if key.contains('{') {
+                        templates.push((key.clone(), value.clone()));
+                    }
+                    exact.insert(key, value);
+                }
+            }
+            // Specific prose before broad templates such as "{} tracks".
+            templates.sort_by_key(|(key, _)| std::cmp::Reverse(key.len()));
+            Catalog { exact, templates }
+        })
+    })
+}
+/// Only call at a presentation boundary. Unknown external errors and user-authored text pass through.
+pub fn t(text: &str) -> String {
+    translate(current(), text)
+}
+/// Format a known message by key. Arguments are opaque: filenames, braces and
+/// user text are never parsed again or used to guess a different message.
+pub fn message(source: &str, values: &[(&str, &str)]) -> String {
+    message_for(current(), source, values)
+}
+pub fn message_for(language: Language, source: &str, values: &[(&str, &str)]) -> String {
+    let render = |pattern: &str| -> Option<String> {
+        let mut result = String::new();
+        for part in parts(pattern)? {
+            match part {
+                Part::Text(text) => result.push_str(text),
+                Part::Slot(key) => result.push_str(values.iter().find(|(name, _)| *name == key)?.1),
+            }
+        }
+        Some(result)
+    };
+    let translated = (language != Language::En).then(|| catalogs()[language.index()].exact.get(source)).flatten();
+    if language != Language::En && translated.is_none() {
+        // Only the developer-authored key is logged; never argument values.
+        eprintln!("[i18n] Missing {} message key: {}", language.code(), source);
+    }
+    render(translated.map_or(source, String::as_str)).or_else(|| render(source)).unwrap_or_else(|| source.to_owned())
+}
+
+/// Present model values without changing their serialized IDs or musical timing.
+pub fn grid_label(value: soundcraft_time::GridValue) -> String {
+    use soundcraft_time::GridValue;
+    match value {
+        GridValue::Note { value, dotted, triplet } => {
+            let mut note = t(value.label());
+            if dotted {
+                note = message("{note} dotted", &[("note", &note)]);
+            }
+            if triplet {
+                note = message("{note} triplet", &[("note", &note)]);
+            }
+            note
+        }
+        GridValue::Seconds(seconds) => message("{value} seconds", &[("value", &format!("{seconds:.3}"))]),
+        GridValue::Frames(1) => t("1 frame"),
+        GridValue::Frames(count) => message("{count} frames", &[("count", &count.to_string())]),
+        GridValue::Samples(count) => message("{count} samples", &[("count", &count.to_string())]),
+    }
+}
