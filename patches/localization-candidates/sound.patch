+    #[test]
+    fn regional_and_script_tags() {
+        for (tag, expected) in [
+            ("vi_VN.UTF-8", Language::Vi),
+            ("ko-KR", Language::Ko),
+            ("ja_JP", Language::Ja),
+            ("en-US", Language::En),
+            ("zh_HK", Language::ZhTw),
+            ("zh-MO", Language::ZhTw),
+            ("zh-Hant-CN", Language::ZhTw),
+            ("zh-Hans-TW", Language::ZhCn),
+            ("zh-SG", Language::ZhCn),
+            ("zh", Language::ZhCn),
+        ] {
+            assert_eq!(normalize(tag), Some(expected), "{tag}");
+        }
+        assert_eq!(normalize("fr-FR"), None);
+    }
+    #[test]
+    fn explicit_device_choice_wins_and_unknown_falls_back() {
+        assert_eq!(resolve(Some("ko"), &["vi-VN".into()]), Language::Ko);
+        assert_eq!(resolve(Some("bad"), &["fr".into(), "zh-Hant-HK".into()]), Language::En);
+        assert_eq!(resolve(None, &["fr".into()]), Language::En);
+        for selected in Language::ALL {
+            let order = menu_order(selected);
+            assert_eq!(order.first(), Some(&selected));
+            assert_eq!(order.len(), 6);
+            assert_eq!(order.iter().filter(|l| **l == selected).count(), 1);
+        }
+    }
+    #[test]
+    fn format_arguments_remain_verbatim() {
+        assert_eq!(
+            render_template("Saved preset {clean}", "Đã lưu thiết lập {clean}", "Saved preset 東京/한글.wav"),
+            Some("Đã lưu thiết lập 東京/한글.wav".into())
+        );
+        assert_eq!(render_template("{name}: {count}", "{count} — {name}", "User name: 12"), Some("12 — User name".into()));
+        assert_eq!(render_template("UI frame time: {:.1} ms", "UI: {:.1} ms", "UI frame time: 12.5 ms"), Some("UI: 12.5 ms".into()));
+    }
+    #[test]
+    fn six_catalogs_have_the_same_nonempty_keys() {
+        let catalogs = catalogs();
+        let english = &catalogs[Language::En.index()].exact;
+        assert!(english.len() > 500);
+        for (i, catalog) in catalogs.iter().enumerate() {
+            assert_eq!(catalog.exact.len(), english.len(), "catalog {i}");
+            for key in english.keys() {
+                assert!(catalog.exact.get(key).is_some_and(|v| !v.trim().is_empty()), "catalog {i}: {key}");
+            }
+        }
+    }
+    #[test]
+    fn legacy_preferences_and_live_session_survive_language_changes() {
+        let legacy: crate::UiState = serde_json::from_value(serde_json::json!({"recent_sessions":["Save.scraft"]})).unwrap();
+        assert_eq!(legacy.language, None);
+        let mut app = crate::SoundApp::new(soundcraft_engine::Engine::default(), None, crate::Services::default());
+        app.ui = legacy;
+        let before = serde_json::to_value(app.engine.session()).unwrap();
+        for language in Language::ALL {
+            app.set_language(language);
+            assert_eq!(serde_json::to_value(app.engine.session()).unwrap(), before);
+            assert_eq!(app.ui.recent_sessions, vec!["Save.scraft"]);
+            let restored: crate::UiState = serde_json::from_slice(&serde_json::to_vec(&app.ui).unwrap()).unwrap();
+            assert_eq!(restored.language.as_deref(), Some(language.code()));
+        }
+        activate(Language::En);
+    }
+}
