+            crate::i18n::activate(language);
+            for seconds in [0, 60, 120, 3_600, 7_200, 86_400, 172_800] {
+                let text = super::ago(seconds);
+                assert!(!text.is_empty());
+                if language != crate::i18n::Language::En {
+                    assert!(!text.contains(" ago"), "{}: {text}", language.code());
+                    assert!(!text.contains("minute"));
+                    assert!(!text.contains("hour"));
+                    assert!(!text.contains("day"));
+                }
+            }
+        }
+        crate::i18n::activate(crate::i18n::Language::En);
+    }
+}
