+//! KIO Deck's authored, device-local six-language interface.
+//!
+//! English source strings are stable lookup keys. Document data, command IDs,
+//! shortcuts, file formats and contributors' names never become translated data.
+//! Catalogs are embedded; no account, browser or network is needed on desktop.
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Language {
+    Vi,
+    En,
+    Ko,
+    Ja,
+    ZhTw,
+    ZhCn,
+}
+
+impl Language {
+    pub const ALL: [Self; 6] = [Self::Vi, Self::En, Self::Ko, Self::Ja, Self::ZhTw, Self::ZhCn];
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::Vi => "vi",
+            Self::En => "en",
+            Self::Ko => "ko",
+            Self::Ja => "ja",
+            Self::ZhTw => "zh-TW",
+            Self::ZhCn => "zh-CN",
+        }
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Vi => "Tiếng Việt",
+            Self::En => "English",
+            Self::Ko => "한국어",
+            Self::Ja => "日本語",
+            Self::ZhTw => "繁體中文",
+            Self::ZhCn => "简体中文",
+        }
+    }
+    pub fn from_tag(tag: &str) -> Option<Self> {
+        let tag = tag.trim_matches([' ', '"', ',']).split(['.', '@']).next().unwrap_or("").replace('_', "-").to_ascii_lowercase();
+        let parts: Vec<&str> = tag.split('-').collect();
+        match parts.first().copied() {
+            Some("vi") => Some(Self::Vi),
+            Some("en" | "c" | "posix") => Some(Self::En),
+            Some("ko") => Some(Self::Ko),
+            Some("ja") => Some(Self::Ja),
+            Some("zh") => Some(if parts.contains(&"hant") {
+                Self::ZhTw
+            } else if parts.contains(&"hans") {
+                Self::ZhCn
+            } else if parts.iter().any(|p| matches!(*p, "tw" | "hk" | "mo")) {
+                Self::ZhTw
+            } else {
+                Self::ZhCn
+            }),
+            _ => None,
+        }
+    }
+    pub fn from_pref(interface_language: &str) -> Self {
+        // Unknown/legacy values have the same recovery policy as Automatic.
+        Self::from_tag(interface_language).unwrap_or_else(system_language)
+    }
+    /// Selected language first; every remaining language keeps the required order.
+    pub fn ordered(self) -> Vec<Self> {
+        std::iter::once(self).chain(Self::ALL.into_iter().filter(|l| *l != self)).collect()
+    }
+    pub fn source(self) -> &'static str {
+        match self {
+            Self::Vi => include_str!("vi.tsv"),
+            Self::En => include_str!("en.tsv"),
+            Self::Ko => include_str!("ko.tsv"),
+            Self::Ja => include_str!("ja.tsv"),
+            Self::ZhTw => include_str!("zh-TW.tsv"),
+            Self::ZhCn => include_str!("zh-CN.tsv"),
+        }
+    }
+    fn index(self) -> usize {
+        match self {
+            Self::Vi => 0,
+            Self::En => 1,
+            Self::Ko => 2,
+            Self::Ja => 3,
+            Self::ZhTw => 4,
+            Self::ZhCn => 5,
+        }
+    }
+}
+
+static SYSTEM: OnceLock<Language> = OnceLock::new();
+thread_local! { static CURRENT: Cell<Language> = const { Cell::new(Language::En) }; }
+
+pub fn set_current(language: Language) {
+    CURRENT.set(language);
+}
+pub fn current() -> Language {
+    CURRENT.get()
+}
+pub fn set_system_locales(tags: &[String]) {
+    let _ = SYSTEM.set(first_supported(tags.iter().map(String::as_str)));
+}
+pub fn first_supported<'a>(tags: impl IntoIterator<Item = &'a str>) -> Language {
+    tags.into_iter().find(|tag| !tag.trim().is_empty()).and_then(Language::from_tag).unwrap_or(Language::En)
+}
+pub fn system_language() -> Language {
+    if cfg!(test) {
+        return Language::En;
+    }
+    *SYSTEM.get_or_init(detect_system_language)
+}
+
+/// Probe the native OS preference before the first frame. This is deliberately
+/// independent of browser languages and any Google/account setting.
+#[cfg(not(target_arch = "wasm32"))]
+fn detect_system_language() -> Language {
+    if let Ok(tag) = std::env::var("KIO_DECK_LOCALE")
+        && let Some(lang) = Language::from_tag(&tag)
+    {
+        return lang;
+    }
+    #[cfg(target_os = "macos")]
+    if let Some(output) = native_output("/usr/bin/defaults", &["read", "-g", "AppleLanguages"]) {
+        let tags: Vec<&str> = output.split(['\n', ',', '(', ')', '"']).map(str::trim).filter(|s| !s.is_empty()).collect();
+        if !tags.is_empty() {
+            return first_supported(tags);
+        }
+    }
+    #[cfg(target_os = "windows")]
+    if let Some(output) = native_output(
+        "powershell.exe",
+        &[
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [System.Globalization.CultureInfo]::CurrentUICulture.Name",
+        ],
+    ) {
+        if output.lines().any(|tag| !tag.trim().is_empty()) {
+            return first_supported(output.lines());
+        }
+    }
+    let mut tags = Vec::new();
+    for key in ["LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"] {
+        if let Ok(value) = std::env::var(key) {
+            tags.extend(value.split(':').map(str::to_string));
+        }
+    }
+    first_supported(tags.iter().map(String::as_str))
+}
+#[cfg(target_arch = "wasm32")]
+fn detect_system_language() -> Language {
+    Language::En
+}
+
+/// Native tools only read user settings. Bound the probe so a broken OS helper
+/// cannot hang startup; then try the locale environment and finally English.
+#[cfg(any(target_os = "macos", target_os = "windows"))]
+fn native_output(program: &str, args: &[&str]) -> Option<String> {
+    use std::process::{Command, Stdio};
+    let mut command = Command::new(program);
+    command.args(args).stdout(Stdio::piped()).stderr(Stdio::null());
+    #[cfg(target_os = "windows")]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x0800_0000);
+    }
+    let mut child = command.spawn().ok()?;
+    let start = std::time::Instant::now();
+    loop {
+        if child.try_wait().ok()?.is_some() {
+            let output = child.wait_with_output().ok()?;
+            return output.status.success().then(|| String::from_utf8_lossy(&output.stdout).trim_start_matches('\u{feff}').to_string());
+        }
+        if start.elapsed() >= std::time::Duration::from_secs(2) {
+            let _ = child.kill();
+            let _ = child.wait();
+            return None;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
+
+#[derive(Default)]
+struct Catalog {
+    plain: HashMap<String, String>,
+    templates: Vec<(String, String)>,
+}
+static CATALOGS: [OnceLock<Catalog>; 6] = [const { OnceLock::new() }; 6];
+fn unescape(s: &str) -> String {
+    let mut out = String::new();
+    let mut chars = s.chars();
+    while let Some(c) = chars.next() {
+        if c == '\\' {
+            match chars.next() {
+                Some('n') => out.push('\n'),
+                Some('t') => out.push('\t'),
+                Some('\\') => out.push('\\'),
+                Some(c) => {
+                    out.push('\\');
+                    out.push(c);
+                }
+                None => out.push('\\'),
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+fn catalog(language: Language) -> &'static Catalog {
+    CATALOGS[language.index()].get_or_init(|| {
+        let mut catalog = Catalog::default();
+        for line in language.source().lines().filter(|l| !l.is_empty() && !l.starts_with('#')) {
+            let mut cols = line.splitn(3, '\t');
+            let (Some(context), Some(source), Some(value)) = (cols.next(), cols.next(), cols.next()) else { continue };
+            let (source, value) = (unescape(source), unescape(value));
+            if context == "@msg" {
+                catalog.templates.push((source.clone(), value.clone()));
+            }
+            catalog.plain.insert(source, value);
+        }
+        catalog.templates.sort_by_key(|(key, _)| std::cmp::Reverse(key.split(['{', '}']).step_by(2).map(str::len).sum::<usize>()));
+        catalog
+    })
+}
+/// Borrowed exact label lookup, including names held by engine/model enums.
+pub fn tr(language: Language, source: &str) -> &str {
+    catalog(language).plain.get(source).map_or(source, String::as_str)
+}
+pub fn t(source: &str) -> &str {
+    tr(current(), source)
+}
+
+/// Formatted labels/errors are translated when shown, keeping the underlying
+/// protocol, undo history and document content in their original form.
+pub fn message(language: Language, source: &str) -> String {
+    let c = catalog(language);
+    if let Some(value) = c.plain.get(source) {
+        return value.clone();
+    }
+    c.templates.iter().find_map(|(key, value)| apply_template(key, value, source)).unwrap_or_else(|| source.to_string())
+}
+pub fn msg(source: &str) -> String {
+    message(current(), source)
+}
+
+fn template_parts(template: &str) -> (Vec<&str>, Vec<&str>) {
+    let mut literals = Vec::new();
+    let mut names = Vec::new();
+    let mut rest = template;
+    while let Some(open) = rest.find('{') {
+        let Some(close) = rest.get(open + 1..).and_then(|s| s.find('}')).map(|i| i + open + 1) else { break };
+        literals.push(rest.get(..open).unwrap_or(""));
+        names.push(rest.get(open + 1..close).unwrap_or(""));
+        rest = rest.get(close + 1..).unwrap_or("");
+    }
+    literals.push(rest);
+    (literals, names)
+}
+fn apply_template(key: &str, value: &str, source: &str) -> Option<String> {
+    let (literals, names) = template_parts(key);
+    if names.is_empty() {
+        return None;
+    }
+    let mut rest = source.strip_prefix(literals.first().copied().unwrap_or(""))?;
+    let mut arguments = Vec::new();
+    for (i, next) in literals.iter().skip(1).enumerate() {
+        let at = if i + 1 == names.len() {
+            rest.len().checked_sub(next.len())?
+        } else {
+            if next.is_empty() {
+                return None;
+            }
+            rest.find(next)?
+        };
+        let part = rest.get(..at)?;
+        if !rest.get(at..)?.starts_with(next) {
+            return None;
+        }
+        arguments.push(part);
+        rest = rest.get(at + next.len()..)?;
+    }
+    if !rest.is_empty() {
+        return None;
+    }
+    let (translated_literals, translated_names) = template_parts(value);
+    let mut out = translated_literals.first().copied().unwrap_or("").to_string();
+    let mut anonymous = 0;
+    for (i, name) in translated_names.iter().enumerate() {
+        let idx = if name.is_empty() || name.starts_with(':') {
+            let idx = anonymous;
+            anonymous += 1;
+            idx
+        } else {
+            names.iter().position(|n| n == name)?
+        };
+        out.push_str(arguments.get(idx)?);
+        out.push_str(translated_literals.get(i + 1).copied().unwrap_or(""));
+    }
+    Some(out)
+}
