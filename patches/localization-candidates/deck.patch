+        ("ko-KR", Language::Ko),
+        ("ja-JP", Language::Ja),
+        ("en-GB", Language::En),
+        ("zh-HK", Language::ZhTw),
+        ("zh-MO", Language::ZhTw),
+        ("zh-Hant-CN", Language::ZhTw),
+        ("zh-Hans-TW", Language::ZhCn),
