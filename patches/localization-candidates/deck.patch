+//! The same globe menu is available on the start screen and in the editor.
+use crate::{
+    SlideApp,
+    i18n::{self, Language},
+};
+
+pub fn show(app: &mut SlideApp, ui: &mut egui::Ui) {
+    let language = Language::from_pref(&app.ui.interface_language);
+    let (rect, response) = ui.allocate_exact_size(egui::vec2(27.0, 24.0), egui::Sense::click());
+    let painter = ui.painter();
+    let ink = crate::theme::Tokens::get(ui.ctx()).text_dim;
+    let center = rect.center();
+    let stroke = egui::Stroke::new(1.2, ink);
+    painter.circle_stroke(center, 7.5, stroke);
+    painter.add(egui::Shape::ellipse_stroke(center, egui::vec2(3.5, 7.5), stroke));
+    painter.line_segment([center - egui::vec2(7.5, 0.0), center + egui::vec2(7.5, 0.0)], stroke);
+    response.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, i18n::t("Language")));
+    let response = response.on_hover_text(i18n::t("Language"));
+    egui::Popup::menu(&response).show(|ui| {
+        ui.set_min_width(180.0);
+        for option in language.ordered() {
+            let selected = language == option;
+            let row = ui.selectable_label(selected, format!("{}  {}", if selected { "✓" } else { "  " }, option.name()));
+            if row.clicked() {
+                app.set_interface_language(option.code());
+                ui.close();
+            }
+        }
+        ui.separator();
+        let automatic = app.ui.interface_language == "auto";
+        if ui.selectable_label(automatic, format!("{}  {}", if automatic { "✓" } else { "  " }, i18n::t("Automatic (system language)"))).clicked() {
+            app.set_interface_language("auto");
+            ui.close();
+        }
+    });
+}
