+use super::*;
+#[test]
+fn normalized_script_region_and_first_os_preference() {
+    for (tag, expected) in [
+        ("vi_VN.UTF-8", Language::Vi),
+        ("ko-KR", Language::Ko),
+        ("ja-JP", Language::Ja),
+        ("en-GB", Language::En),
+        ("zh-HK", Language::ZhTw),
+        ("zh-MO", Language::ZhTw),
+        ("zh-Hant-CN", Language::ZhTw),
+        ("zh-Hans-TW", Language::ZhCn),
+        ("zh", Language::ZhCn),
+        ("zh-SG", Language::ZhCn),
+    ] {
+        assert_eq!(Language::from_tag(tag), Some(expected), "{tag}");
+    }
+    assert_eq!(first_supported(["fr-FR", "ko-KR"]), Language::En);
+    assert_eq!(first_supported(["", "ja-JP", "ko-KR"]), Language::Ja);
+    assert_eq!(first_supported([]), Language::En);
+}
+#[test]
+fn device_choice_and_menu_order_are_stable() {
+    for language in Language::ALL {
+        assert_eq!(Language::from_pref(language.code()), language);
+        let mut expected = vec![language];
+        expected.extend(Language::ALL.into_iter().filter(|l| *l != language));
+        assert_eq!(language.ordered(), expected);
+    }
+    assert_eq!(Language::from_pref("ko-KR"), Language::Ko);
+}
+#[test]
+fn named_arguments_reorder_without_changing_user_text() {
+    assert_eq!(apply_template("Saved {path}", "Đã lưu {path}", "Saved 東京/한글.deckcraft"), Some("Đã lưu 東京/한글.deckcraft".into()));
+    assert_eq!(apply_template("{name}: {count}", "{count} — {name}", "User text: 42"), Some("42 — User text".into()));
+    assert_eq!(apply_template("{one}{two}", "{one}{two}", "ambiguous"), None);
+}
+#[test]
+fn switching_language_does_not_rewrite_source_or_unknown_user_text() {
+    let source = "A user's presentation title";
+    for language in Language::ALL {
+        set_current(language);
+        assert_eq!(t(source), source);
+        assert_eq!(msg(source), source);
+    }
+    set_current(Language::Vi);
+    assert_eq!(t("Language"), "Ngôn ngữ");
+    set_current(Language::Ko);
+    assert_eq!(t("Language"), "언어");
+    set_current(Language::En);
+}
+
+#[test]
+fn legacy_preferences_default_to_auto_and_saved_choice_survives_serialization() {
+    let original = serde_json::json!({"tab":"insert", "notes":true, "zoom":1.25});
+    let mut state: crate::UiState = serde_json::from_value(original).unwrap();
+    assert_eq!(state.interface_language, "auto");
+    assert_eq!(state.tab, "insert");
+    for language in Language::ALL {
+        state.interface_language = language.code().into();
+        let restored: crate::UiState = serde_json::from_slice(&serde_json::to_vec(&state).unwrap()).unwrap();
+        assert_eq!(restored.interface_language, language.code());
+        assert_eq!(restored.tab, "insert");
+        assert!(restored.notes);
+    }
+}
