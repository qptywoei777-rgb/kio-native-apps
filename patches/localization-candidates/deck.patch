+use super::*;
+#[test]
+fn six_catalogs_keep_all_nonempty_source_keys_and_parameters() {
+    let english = catalog(Language::En);
+    assert!(english.plain.len() > 1000);
+    for language in Language::ALL {
+        let translated = catalog(language);
+        assert_eq!(english.plain.len(), translated.plain.len(), "{}", language.code());
+        for (key, original) in &english.plain {
+            let value = translated.plain.get(key).expect("missing localized key");
+            assert!(!value.trim().is_empty(), "{}: {key}", language.code());
+            let mut expected = template_parts(original).1;
+            let mut actual = template_parts(value).1;
+            expected.sort(); actual.sort();
+            assert_eq!(expected, actual, "{}: {key}", language.code());
+        }
+    }
+}
