+            let text = localized_note(language, &ranges);
+            assert_eq!(text.matches(value).count(), 1);
+            assert!(text.contains("A1:B2"));
+            assert!(text.contains(language.tr(" (password, unlocked)")));
+        }
+        assert_eq!(note, Field::Message { key: "'{file}' is protected.", arguments: vec![("file", value.into())] });
