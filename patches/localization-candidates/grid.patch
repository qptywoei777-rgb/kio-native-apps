+    fn form_notes_retranslate_without_touching_opaque_names_and_urls() {
+        let value = "Home / {summary} 東京 한글 https://example.invalid/?q={file}";
+        let note = Field::Message { key: "'{file}' is protected.", arguments: vec![("file", value.into())] };
+        let ranges = Field::EditableRanges(json!([{"title":value,"range":"A1:B2","password":true,"unlocked":true}]));
+        for language in crate::i18n::Language::PRIMARY {
+            let text = localized_note(language, &note);
