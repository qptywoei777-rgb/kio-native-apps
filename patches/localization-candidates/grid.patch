+    /// Substitute opaque values in a translated template once; inserted braces are not re-read.
+    pub fn msg(self, key: &str, arguments: &[(&str, &str)]) -> String {
+        let template = self.tr(key);
+        let mut result = String::new();
+        let mut rest = template;
+        while let Some(start) = rest.find('{') {
+            result.push_str(&rest[..start]);
+            let Some(end) = rest[start..].find('}') else {
+                result.push_str(&rest[start..]);
+                return result;
+            };
+            let name = &rest[start + 1..start + end];
+            if let Some((_, value)) = arguments.iter().find(|(candidate, _)| *candidate == name) {
+                result.push_str(value);
+            } else {
+                result.push_str(&rest[start..start + end + 1]);
+                log::warn!("Missing interface message argument in KIO Grid key: {}", key);
+            }
+            rest = &rest[start + end + 1..];
+        }
+        result.push_str(rest);
+        result
+    }
