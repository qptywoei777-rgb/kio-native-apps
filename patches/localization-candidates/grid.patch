+    /// Present known KIO messages without modifying stored diagnostics or user data.
+    /// Unclassified platform/engine diagnostics remain verbatim for the separate
+    /// runtime-message audit; never guess at or log names embedded in them.
+    pub fn display_message(self, text: &str) -> String {
+        if let Some(translated) = catalog::lookup(self, text) {
+            return translated.to_owned();
+        }
+        if let Some(count) = text.strip_suffix(" cell(s) found").filter(|v| v.parse::<u64>().is_ok()) {
+            return self.msg("{count} cell(s) found", &[("count", count)]);
+        }
+        if let Some(count) =
+            text.strip_prefix("All done. We made ").and_then(|s| s.strip_suffix(" replacements.")).filter(|v| v.parse::<u64>().is_ok())
+        {
+            return self.msg("All done. We made {count} replacements.", &[("count", count)]);
+        }
+        if let Some(value) = text.strip_prefix("Goal Seeking found a solution: ") {
+            return self.msg("Goal Seeking found a solution: {value}", &[("value", value)]);
+        }
+        if let Some((count, warning)) = text.split_once(" items in this file were handled differently. First: ")
+            && count.parse::<u64>().is_ok()
+        {
+            return self.msg(
+                "{count} items in this file were handled differently. First: {warning}",
+                &[("count", count), ("warning", &self.display_message(warning))],
+            );
+        }
+        text.to_owned()
+    }
