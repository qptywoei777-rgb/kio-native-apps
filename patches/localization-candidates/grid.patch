+    #[test]
+    fn rendered_form_captions_follow_language_without_replacing_input_or_wire_values() {
+        fn texts(shape: &egui::epaint::Shape, result: &mut Vec<String>) {
+            match shape {
+                egui::epaint::Shape::Text(text) => result.push(text.galley.job.text.clone()),
+                egui::epaint::Shape::Vec(children) => {
+                    for child in children {
+                        texts(child, result);
+                    }
+                }
+                _ => {}
+            }
+        }
+        let mut dialog = Dialog::form(
+            "test",
+            "test",
+            "data.validation",
+            vec![
+                Field::Text { key: "name", label: "Title:" },
+                Field::Choice { key: "action", label: "Action", options: vec![("stable-wire-value", "New")] },
+                Field::Check { key: "enabled", label: "Show Zeros" },
+            ],
+            json!({"name":"Home {file} 東京 한글", "action":"stable-wire-value", "enabled":true}),
+        );
+        let before = dialog.values.clone();
+        let context = egui::Context::default();
+        for language in crate::i18n::Language::PRIMARY {
+            let mut displayed = Vec::new();
+            // A second pass lets egui complete initial layout before we inspect paint output.
+            for _ in 0..2 {
+                let mut output = context.run_ui(
+                    egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, vec2(900.0, 600.0))), ..Default::default() },
+                    |ui| {
+                        crate::i18n::set_current(ui.ctx(), language);
+                        egui::CentralPanel::default().show(ui, |ui| {
+                            form_fields(ui, &mut dialog);
+                        });
+                    },
+                );
+                displayed.clear();
+                for shape in output.shapes {
+                    texts(&shape.shape, &mut displayed);
+                }
+                output.textures_delta.clear();
+            }
+            assert!(displayed.iter().any(|text| text == language.tr("Title:")), "{language:?}: {displayed:?}");
+            assert!(displayed.iter().any(|text| text == language.tr("Action")), "{language:?}: {displayed:?}");
+            assert!(displayed.iter().any(|text| text == language.tr("New")), "{language:?}: {displayed:?}");
+            assert!(displayed.iter().any(|text| text == language.tr("Show Zeros")), "{language:?}: {displayed:?}");
+            assert_eq!(dialog.values, before);
+        }
+    }
 
