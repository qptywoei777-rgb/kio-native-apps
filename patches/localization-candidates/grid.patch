+                ui.close();
+            }
+        }
+        ui.separator();
+        if ui.selectable_label(!app.ui.language_explicit, lang.tr("Follow system language")).clicked() {
+            act(app, "app.language.set", json!({"language": "auto"}));
+            ui.close();
+        }
+    })
+    .response
+    .on_hover_text(lang.tr("Interface language"));
+}
