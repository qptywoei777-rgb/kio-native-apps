+
+/// Localize interface templates each frame; names, addresses and input values
+/// stay opaque even when they themselves contain braces or interface words.
+fn localized_note(language: crate::i18n::Language, field: &Field) -> String {
+    match field {
+        Field::Note(key) => language.tr(key).to_owned(),
+        Field::Message { key, arguments } => {
+            let arguments: Vec<_> = arguments
+                .iter()
+                .map(|(name, value)| (*name, if *name == "file" && value.is_empty() { language.tr("this workbook") } else { value.as_str() }))
+                .collect();
+            language.msg(key, &arguments)
+        }
+        Field::EditableRanges(list) => {
+            let rows: Vec<String> = list
+                .as_array()
+                .into_iter()
+                .flatten()
+                .map(|row| {
+                    let lock = match (row["password"].as_bool(), row["unlocked"].as_bool()) {
+                        (Some(true), Some(true)) => language.tr(" (password, unlocked)"),
+                        (Some(true), _) => language.tr(" (password)"),
+                        _ => "",
+                    };
+                    format!("{}: {}{lock}", row["title"].as_str().unwrap_or(""), row["range"].as_str().unwrap_or(""))
+                })
+                .collect();
+            let summary = if rows.is_empty() { language.tr("No ranges yet.").to_owned() } else { rows.join("\n") };
+            language.msg("Ranges that stay editable when the sheet is protected:\n{summary}", &[("summary", &summary)])
+        }
+        _ => String::new(),
+    }
 }
 
