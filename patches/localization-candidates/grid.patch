+//! Actual desktop display-language preferences, before the first frame.
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn languages() -> Vec<String> {
+    // The existing pinned sys-locale dependency calls GetUserPreferredUILanguages
+    // on Windows and CFLocaleCopyPreferredLanguages on macOS. Keep that actual
+    // display-language order ahead of process culture and regional fallbacks.
+    #[cfg(any(target_os = "macos", target_os = "windows"))]
+    {
+        let native: Vec<String> = sys_locale::get_locales().filter(|tag| !tag.trim().is_empty()).collect();
+        if !native.is_empty() {
+            return native;
+        }
+    }
+    #[cfg(target_os = "macos")]
+    if let Some(output) = native_output("/usr/bin/defaults", &["read", "-g", "AppleLanguages"]) {
+        let values: Vec<String> = output.split([',', '\n', '(', ')', '"']).map(str::trim).filter(|s| !s.is_empty()).map(str::to_owned).collect();
+        if !values.is_empty() {
+            return values;
+        }
+    }
+    #[cfg(target_os = "windows")]
+    if let Some(output) = native_output(
+        "powershell.exe",
+        &[
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;[System.Globalization.CultureInfo]::CurrentUICulture.Name",
+        ],
+    ) {
+        let value = output.trim().to_owned();
+        if !value.is_empty() {
+            return vec![value];
+        }
+    }
+    let tags: Vec<String> = ["LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"]
+        .iter()
+        .filter_map(|key| std::env::var(key).ok())
+        .flat_map(|s| s.split(':').map(str::to_owned).collect::<Vec<_>>())
+        .collect();
+    if tags.is_empty() { sys_locale::get_locale().into_iter().collect() } else { tags }
+}
+
+// A broken fallback helper must not block the interface startup indefinitely.
+#[cfg(any(target_os = "macos", target_os = "windows"))]
+// The monotonic fallback deadline is compiled only for native desktop targets;
+// std::time::Instant is never compiled or called by this module on wasm.
+#[allow(clippy::disallowed_methods)]
+fn native_output(program: &str, args: &[&str]) -> Option<String> {
+    use std::process::{Command, Stdio};
+    let mut command = Command::new(program);
+    command.args(args).stdout(Stdio::piped()).stderr(Stdio::null());
+    #[cfg(target_os = "windows")]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x0800_0000);
+    }
+    let mut child = command.spawn().ok()?;
+    let start = std::time::Instant::now();
+    loop {
+        if child.try_wait().ok()?.is_some() {
+            let output = child.wait_with_output().ok()?;
+            return output.status.success().then(|| String::from_utf8_lossy(&output.stdout).trim_start_matches('\u{feff}').to_string());
+        }
+        if start.elapsed() >= std::time::Duration::from_secs(2) {
+            let _ = child.kill();
+            let _ = child.wait();
+            return None;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
