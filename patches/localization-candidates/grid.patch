+//! Source-keyed presentation overlay. No workbook contents or formula identifiers enter it.
+use super::Language;
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, OnceLock};
+
+const SOURCES: [(&str, &str); 6] = [
+    ("vi", include_str!("vi.tsv")),
+    ("en", include_str!("en.tsv")),
+    ("ko", include_str!("ko.tsv")),
+    ("ja", include_str!("ja.tsv")),
+    ("zh-TW", include_str!("zh-TW.tsv")),
+    ("zh-CN", include_str!("zh-CN.tsv")),
+];
+type Catalog = HashMap<String, HashMap<String, String>>;
+
+pub(super) fn platform_shortcuts(text: &str) -> String {
+    if !cfg!(target_os = "windows") {
+        return text.to_owned();
+    }
+    let mut result = String::new();
+    let mut chars = text.chars().peekable();
+    while let Some(c) = chars.next() {
+        let name = match c {
+            '⌘' | '⌃' => "Ctrl",
+            '⇧' => "Shift",
+            '⌥' => "Alt",
+            _ => {
+                result.push(c);
+                continue;
+            }
+        };
+        result.push_str(name);
+        if chars.peek().is_some_and(|next| next.is_alphanumeric() || matches!(*next, '⌘' | '⌃' | '⇧' | '⌥' | '↑' | '↓' | '←' | '→' | '{'))
+        {
+            result.push('+');
+        }
+    }
+    result
+}
+fn unescape(text: &str) -> String {
+    let mut result = String::new();
+    let mut chars = text.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            result.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('n') => result.push('\n'),
+            Some('t') => result.push('\t'),
+            Some('\\') => result.push('\\'),
+            Some(other) => {
+                result.push('\\');
+                result.push(other);
+            }
+            None => result.push('\\'),
+        }
+    }
+    result
+}
+fn catalogs() -> &'static Catalog {
+    static CATALOG: OnceLock<Catalog> = OnceLock::new();
+    CATALOG.get_or_init(|| {
+        SOURCES
+            .into_iter()
+            .map(|(code, text)| {
+                let rows = text
+                    .lines()
+                    .filter(|line| !line.starts_with('#') && !line.is_empty())
+                    .filter_map(|line| {
+                        let mut columns = line.split('\t');
+                        let _context = columns.next()?;
+                        let key = unescape(columns.next()?);
+                        let value = platform_shortcuts(&unescape(columns.next()?));
+                        if columns.next().is_some() || value.trim().is_empty() {
+                            return None;
+                        }
+                        Some((key, value))
+                    })
+                    .collect();
+                (code.to_owned(), rows)
+            })
+            .collect()
+    })
+}
+pub(super) fn lookup(language: Language, key: &str) -> Option<&'static str> {
+    catalogs().get(language.code())?.get(key).map(String::as_str)
+}
+pub(super) fn diagnose_missing(language: Language, key: &str) {
+    if language == Language::En || !catalogs().contains_key(language.code()) || lookup(Language::En, key).is_none() {
+        return;
+    }
+    static REPORTED: OnceLock<Mutex<HashSet<(String, String)>>> = OnceLock::new();
+    let mut reported = REPORTED.get_or_init(Mutex::default).lock().unwrap_or_else(|e| e.into_inner());
+    if reported.insert((language.code().to_owned(), key.to_owned())) {
+        // Only compile-time interface keys, never arbitrary values, paths or cell contents.
+        log::warn!("Missing KIO Grid interface translation [{}]: {}", language.code(), key);
+    }
+}
